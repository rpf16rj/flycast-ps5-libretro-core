diff --git a/core/linux/posix_vmem.cpp b/core/linux/posix_vmem.cpp
index 2d42410..d1eae72 100644
--- a/core/linux/posix_vmem.cpp
+++ b/core/linux/posix_vmem.cpp
@@ -20,6 +20,15 @@
 #define MAP_NOSYNC 0
 #endif
 
+#if defined(__PROSPERO__)
+// Executable memory is provided by the PS5 RetroArch title runtime.
+// ps5_exec_allocate() returns RWX memory from 4MB exec pools (small
+// allocations) or a dedicated mapping (large ones); ps5_exec_release()
+// frees it.
+extern "C" void *ps5_exec_allocate(size_t size, void *tag);
+extern "C" int ps5_exec_release(void *ptr);
+#endif
+
 #ifdef __ANDROID__
 #include <linux/ashmem.h>
 
@@ -248,6 +257,17 @@ void create_mappings(const Mapping *vmem_maps, unsigned nummaps) {
 // Prepares the code region for JIT operations, thus marking it as RWX
 bool prepare_jit_block(void *code_area, size_t size, void **code_area_rwx)
 {
+#if defined(__PROSPERO__)
+	// The PS5 W^X policy doesn't allow turning regular memory executable,
+	// use the title-provided exec allocator instead and ignore code_area.
+	static const char jit_tag = 0;
+	(void)code_area;
+	void *ret_ptr = ps5_exec_allocate(size, (void *)&jit_tag);
+	if (ret_ptr == nullptr || ret_ptr == (void *)-1)
+		return false;
+	*code_area_rwx = ret_ptr;
+	return true;
+#else
     // Try to map is as RWX, this fails apparently on OSX (and perhaps other systems?)
 	if (code_area != nullptr && region_set_exec(code_area, size))
     {
@@ -279,11 +299,18 @@ bool prepare_jit_block(void *code_area, size_t size, void **code_area_rwx)
 #endif
     *code_area_rwx = ret_ptr;
     return true;
+#endif // __PROSPERO__
 }
 
 void release_jit_block(void *code_area, size_t size)
 {
+#if defined(__PROSPERO__)
+	(void)size;
+	if (code_area != nullptr)
+		ps5_exec_release(code_area);
+#else
 	munmap(code_area, size);
+#endif
 }
 
